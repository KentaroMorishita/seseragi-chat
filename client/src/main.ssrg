import * as arrays from "std/array"
import * as dom from "std/web/dom"
import * as effects from "std/effect"
import * as html from "std/web/html"
import * as refs from "std/ref"
import * as signals from "std/signal"
import * as streams from "std/stream"
import * as websocket from "std/websocket"
import { Ref } from "std/ref"
import { MutableSignal } from "std/signal"

struct Model {
  name: String,
  draft: String,
  messages: Array<String>,
  status: String,
}

type Action =
  | NameChanged String
  | DraftChanged String
  | Submitted

type ConnectionState =
  | Connecting
  | Connected websocket.WebSocketConnection
  | Disconnected

let initial = Model {
  name: "Guest",
  draft: "",
  messages: [],
  status: "Connecting…",
}

let pageStyle = html.style {
  backgroundColor: "#f6f7fb",
  color: "#111827",
  minHeight: "100vh",
  padding: "24px"
}

let cardStyle = html.style {
  backgroundColor: "#ffffff",
  borderRadius: "24px",
  boxShadow: "0 18px 50px #11182712",
  margin: "24px auto",
  maxWidth: "720px",
  padding: "24px"
}

let titleStyle = html.style {
  margin: "0 0 6px 0",
  fontSize: "28px",
  fontWeight: "700"
}

let mutedStyle = html.style {
  color: "#6b7280",
  margin: "0 0 20px 0"
}

let fieldStyle = html.style {
  borderRadius: "14px",
  border: "1px solid #d1d5db",
  padding: "12px 14px",
  width: "100%"
}

let nameStyle = html.style {
  borderRadius: "12px",
  border: "1px solid #d1d5db",
  margin: "0 0 16px 0",
  padding: "10px 12px",
  width: "100%"
}

let messagesStyle = html.style {
  backgroundColor: "#f9fafb",
  borderRadius: "18px",
  minHeight: "320px",
  padding: "16px",
  margin: "0 0 16px 0"
}

let messageStyle = html.style {
  backgroundColor: "#ffffff",
  borderRadius: "14px",
  boxShadow: "0 1px 3px #1118270d",
  margin: "0 0 10px 0",
  padding: "10px 12px"
}

let buttonStyle = html.style {
  backgroundColor: "#111827",
  borderRadius: "14px",
  color: "#ffffff",
  fontWeight: "700",
  margin: "10px 0 0 0",
  padding: "12px 18px",
  width: "100%"
}

fn impossibleString _failure: Never -> String =
  "unreachable"

fn errorText error: websocket.WebSocketError -> String =
  websocket.errorMessage error

fn ignoreString _error: String -> Task<Unit> =
  effects.succeed ()

fn nameAction event: html.InputEvent -> Action =
  NameChanged event.value

fn draftAction event: html.InputEvent -> Action =
  DraftChanged event.value

fn messageView message: String -> html.Html<Action> =
  html.div { style: messageStyle, children: message }

fn messagesView messages: Array<String> -> html.Html<Action> =
  html.div {
    style: messagesStyle,
    children: map messageView messages
  }

fn view model: Model -> html.Html<Action> =
  html.main {
    style: pageStyle,
    children: html.section {
      style: cardStyle,
      children: [
        html.h1 { style: titleStyle, children: "Seseragi Chat" },
        html.p {
          style: mutedStyle,
          children: `DBなし / 1 room / WebSocket — ${model.status}`
        },
        html.input {
          name: "name",
          inputType: "text",
          value: model.name,
          placeholder: "Your name",
          onInput: nameAction,
          style: nameStyle
        },
        messagesView model.messages,
        html.form {
          onSubmit: Submitted,
          children: [
            html.input {
              name: "message",
              inputType: "text",
              value: model.draft,
              placeholder: "Type a message",
              onInput: draftAction,
              style: fieldStyle
            },
            html.button {
              buttonType: "submit",
              style: buttonStyle,
              children: "Send"
            }
          ]
        }
      ]
    }
  }

fn appendMessage state: MutableSignal<Model> -> text: String -> Task<Unit> =
  signals.update
    (\model: Model -> Model {
      ...model,
      messages: arrays.append [text] model.messages,
    })
    state

fn appendMessageWithError
  state: MutableSignal<Model>
  -> text: String
  -> Effect<{}, String, Unit> =
  appendMessage state text
    |> effects.mapError impossibleString

fn clearDraft state: MutableSignal<Model> -> Task<Unit> =
  signals.update (\model: Model -> Model { ...model, draft: "" }) state

fn markConnected state: MutableSignal<Model> -> Task<Unit> =
  signals.update
    (\model: Model -> Model { ...model, status: "Connected" })
    state

fn markDisconnected state: MutableSignal<Model> -> Task<Unit> =
  signals.update
    (\model: Model -> Model { ...model, status: "Disconnected" })
    state

fn markUnavailable state: MutableSignal<Model> -> Task<Unit> =
  signals.update
    (\model: Model -> Model { ...model, status: "Server unavailable" })
    state

fn textEvent event: websocket.WebSocketEvent -> Maybe<String> =
  websocket.foldEvent
    (\text: String -> Just text)
    (\_ -> Nothing)
    (\_ -> Nothing)
    event

fn receive
  state: MutableSignal<Model>
  -> connectionState: Ref<ConnectionState>
  -> connection: websocket.WebSocketConnection
  -> Task<Unit> =
  do {
    websocket.messages connection
      |> streams.filterMap textEvent
      |> streams.mapError errorText
      |> streams.runForEach (appendMessageWithError state)
      |> effects.recover ignoreString

    refs.set Disconnected connectionState
    markDisconnected state
  }

fn connectionFailed
  state: MutableSignal<Model>
  -> connectionState: Ref<ConnectionState>
  -> _error: String
  -> Task<Unit> =
  do {
    refs.set Disconnected connectionState
    markUnavailable state
  }

fn sendFailed
  state: MutableSignal<Model>
  -> _error: websocket.WebSocketError
  -> Task<Unit> =
  signals.update
    (\model: Model -> Model { ...model, status: "Send failed" })
    state

fn handle
  state: MutableSignal<Model>
  -> connectionState: Ref<ConnectionState>
  -> action: Action
  -> Task<Unit> =
  match action {
    NameChanged value ->
      signals.update (\model: Model -> Model { ...model, name: value }) state

    DraftChanged value ->
      signals.update (\model: Model -> Model { ...model, draft: value }) state

    Submitted -> do {
      current <- *state
      if current.draft == "" then
        effects.succeed ()
      else
        do {
          connection <- refs.get connectionState
          match connection {
            Connecting ->
              effects.succeed ()

            Disconnected ->
              markUnavailable state

            Connected socket -> do {
              websocket.sendText `${current.name}: ${current.draft}` socket
                |> effects.recover (sendFailed state)
              clearDraft state
            }
          }
        }
    }
  }

pub effect fn main -> Unit
with dom: dom.Dom, webSocketClient: websocket.WebSocketClient
fails String =
  do {
    state <- signals.make initial
      |> effects.mapError impossibleString
    connectionState <- refs.make Connecting
      |> effects.mapError impossibleString

    capacity <- streams.bufferCapacity 32
      |> effects.fromEither
      |> effects.mapError (\error: streams.BufferCapacityError -> show error)

    _connector <- effects.fork (
      do {
        connection <- websocket.connect {
          url: "ws://127.0.0.1:41290/chat",
          protocols: ["seseragi.chat.v1"],
          receiveBuffer: capacity,
        }
          |> effects.mapError errorText
        refs.set (Connected connection) connectionState
          |> effects.mapError impossibleString
        markConnected state
          |> effects.mapError impossibleString
        receive state connectionState connection
          |> effects.mapError impossibleString
      }
        |> effects.recover (connectionFailed state connectionState)
    )
      |> effects.mapError impossibleString

    let content = signals.map view state
    let options = dom.defaultOptions ()

    target <- dom.query "#app"
      |> effects.mapError (\error: dom.DomError -> show error)

    dom.run options target (handle state connectionState) content
      |> effects.mapError (\error: dom.DomRuntimeError<Never> -> show error)
  }
